@model IEnumerable<Student>;
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<h1>หน้าแรก</h1>
@if(Model.Count() > 0){
    <table class="table">
    <thead>
        <tr>
            <th>รหัสนักศึกษา</th>
            <th>คำนำหน้า</th>
            <th>ชื่อ</th>
            <th>นามสกุล</th>
            <th>วันเดือนปีเกิด</th>
            <th>สำนักวิชา</th>
            <th>แก้ไข</th>
            <th>ลบ</th>
        </tr>       
    </thead>
    <tbody>
        <tr>
            @foreach (var student in Model)
            {
                <td>@student.StudentId</td>
                <td>@student.Honorifics</td>
                <td>@student.FirstName</td>
                <td>@student.LastName</td>
                <td>@student.DateOfBirth</td>
                <td>@student.Faculty</td>
                <td><a class="btn btn-warning"
                asp-controller="Student" asp-action="Edit" 
                asp-route-id="@student.Id">แก้ไข</a></td>
                <td><a class="btn btn-danger"
                asp-controller="Student" asp-action="Delete" 
                asp-route-id="@student.Id" onclick="return confirm('คุณยืนยันที่จะลบข้อมูลของ @student.FirstName @student.LastName หรือไม่?')">ลบ</a></td>
            }
        </tr>
    </tbody>
</table>
    }else
    {
        <div class="alert alert-secondary">ไม่มีข้อมูลนักศึกษา</div>
    }



